{
  // 格式化统一交给 ESLint(@antfu/eslint-config),不使用 Prettier。
  // Volar(vue.volar)自带 formatter,不显式关闭会与 ESLint 的 fixAll 抢格式化权,
  // 把 .vue 改成双引号+分号风格。
  "prettier.enable": false,
  "editor.formatOnSave": false,
  "vue.format.enable": false,

  // 保存时由 ESLint 做修复式格式化
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // 让 ESLint 接管这些语言(@antfu/eslint-config 覆盖的范围)
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "yaml"
  ],

  // 关掉各语言的内置格式化器,避免与 ESLint 抢
  "[vue]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[typescript]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[javascript]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[json]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[jsonc]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },
  "[markdown]": { "editor.defaultFormatter": "dbaeumer.vscode-eslint" },

  // Volar 接管 .vue 的类型服务(Nuxt 的自动导入类型由 .nuxt/ 下生成的 tsconfig 提供)
  "typescript.tsdk": "node_modules/typescript/lib"
}
