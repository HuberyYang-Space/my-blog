---
import BaseLayout from '../layouts/BaseLayout.astro';

// 静态托管平台按约定使用产物里的 404.html 作为兜底页,无需额外路由配置。
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已被移动。">
  <section class="py-16 text-center">
    <p class="text-4xl text-text-mute font-semibold tracking-tight">404</p>
    <h1 class="mt-4 text-xl font-semibold tracking-tight">页面不存在</h1>
    <p class="mt-3 text-text-soft">你访问的地址可能已经变更或被移除。</p>
    <a
      href="/"
      class="mt-8 inline-block text-sm text-primary transition-opacity hover:opacity-80"
    >
      ← 返回首页
    </a>
  </section>
</BaseLayout>
