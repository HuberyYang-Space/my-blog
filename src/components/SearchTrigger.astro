---
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro'
---

{/*
  Pagefind 索引由 astro-pagefind 在 `astro:build:done` 钩子中生成,
  因此开发模式下 dist/pagefind 不存在、搜索无结果属正常现象,
  功能需以 `pnpm build && pnpm preview` 验证。
*/}
<PagefindConfig />
<pagefind-modal-trigger></pagefind-modal-trigger>
{/* reset-on-close:关闭弹层时清空搜索词,避免下次唤起时残留上一次的查询 */}
<pagefind-modal reset-on-close></pagefind-modal>
