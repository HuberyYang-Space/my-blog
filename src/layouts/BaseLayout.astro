---
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { SITE } from '../config'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** 文章页传 'article',其余页面用默认的 'website' */
  ogType?: 'website' | 'article'
  /** 仅 ogType 为 'article' 时有意义,输出 article:published_time */
  publishedDate?: Date
  /** 加宽正文容器(max-w-2xl → max-w-3xl)。目前仅文章详情页需要,给代码块/表格留呼吸空间 */
  wide?: boolean
}

const { title, description, ogType = 'website', publishedDate, wide = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
// OG 图必须是绝对 URL —— 抓取方(微信/Twitter/Slack)不在本站上下文中解析相对路径
const ogImage = new URL(SITE.ogImage, Astro.site)

// aside 具名插槽承载文章大纲。只有传入内容时才腾出右侧 sticky 列,
// 其余页面(首页/about/标签页)不受影响,不会凭空多出空白列。
const hasAside = Astro.slots.has('aside')
const contentWidth = wide ? 'max-w-3xl' : 'max-w-2xl'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    {/*
      防闪烁:必须是 <head> 的首个子节点,且必须同步内联执行。
      目的是在浏览器首次绘制之前就把 .dark 落到 <html> 上,
      否则会先按浅色绘制一帧,深色用户能看到明显的白屏闪烁。
      is:inline 让 Astro 原样输出,不做模块化搬运。
    */}
    <script is:inline>
      ;(function () {
        try {
          const stored = localStorage.getItem('theme')
          const isDark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches
          if (isDark) {
            document.documentElement.classList.add('dark')
            // Pagefind 组件库以该属性作为暗色选择器
            document.documentElement.setAttribute('data-pf-theme', 'dark')
          }
        }
        catch {
          // 隐私模式下 localStorage 不可用,回退到浅色
        }
      })()
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      ogType === 'article' && publishedDate && (
        <meta
          property="article:published_time"
          content={publishedDate.toISOString()}
        />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href="/rss.xml"
    />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <Header />
    <div
      class={`mx-auto min-h-screen flex flex-col px-6 ${hasAside ? 'post-shell' : contentWidth}`}
    >
      <main class={`flex-1 ${hasAside ? 'post-grid lg:grid lg:items-start lg:gap-x-10' : ''}`}>
        <div class={`mx-auto w-full ${hasAside ? `${contentWidth} lg:col-start-2` : contentWidth}`}>
          <slot />
        </div>
        {
          hasAside && (
            <aside class="hidden lg:sticky lg:top-20 lg:col-start-3 lg:block lg:w-56 lg:justify-self-end lg:pt-6">
              <slot name="aside" />
            </aside>
          )
        }
      </main>
      <div class={`w-full ${hasAside ? `${contentWidth} mx-auto` : ''}`}>
        <Footer />
      </div>
    </div>
  </body>
</html>
