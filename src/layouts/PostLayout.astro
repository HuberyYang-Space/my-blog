---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'
import FormattedDate from '../components/FormattedDate.astro'
import PostNav from '../components/PostNav.astro'
import PostOutline from '../components/PostOutline.astro'
import BaseLayout from './BaseLayout.astro'

interface Props {
  post: CollectionEntry<'blog'>
  headings: MarkdownHeading[]
  /** 较早发布的文章 */
  olderPost?: CollectionEntry<'blog'>
  /** 较新发布的文章 */
  newerPost?: CollectionEntry<'blog'>
}

const { post, headings, olderPost, newerPost } = Astro.props
const { title, description, date, updatedDate, tags } = post.data

// 大纲只在标题足够多时才有意义 —— 少于 3 个 h2 的短文放一个几乎空的框只是噪音
const h2Count = headings.filter(h => h.depth === 2).length
const showOutline = h2Count >= 3
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedDate={date}
  wide
>
  {
    /*
    data-pagefind-body 让 Pagefind 只索引文章正文所在的这棵子树。
    没有该属性时 Pagefind 会索引整页,页眉页脚的文字会污染每一条搜索结果的摘要。
    同时:只有文章页带此标记,意味着首页等列表页不会被索引成一条结果。
  */
  }
  <article data-pagefind-body>
    <header class="post-intro mb-10 border-b border-border pb-6">
      {/* data-pagefind-meta 把标题登记为条目元数据,而非正文的一部分 */}
      <h1
        class="text-2xl font-semibold tracking-tight sm:text-3xl"
        data-pagefind-meta="title"
      >
        {title}
      </h1>
      {
        /*
        data-pagefind-ignore 把日期/标签排除出正文索引。
        否则搜索结果摘要会以"2026年7月25日#CSS#前端工程"开头,把真正的正文挤掉。
        标签的 data-pagefind-filter 不受影响 —— filter 的采集独立于正文索引。

        元信息行改用等宽字体,格式仿 git log / commit trailer(日期 · 标签 · 标签)——
        这是这个博客的受众(前端工程师)一眼就能认出的语汇,而非随手挑一个"数据用字体"。
      */
      }
      <div
        class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-text-mute font-mono"
        data-pagefind-ignore
      >
        <FormattedDate date={date} />
        {
          updatedDate && (
            <span class="flex items-center gap-2">
              <span aria-hidden="true">·</span>
              更新于 <FormattedDate date={updatedDate} />
            </span>
          )
        }
        {
          tags.map(tag => (
            <span class="flex items-center gap-2">
              <span aria-hidden="true">·</span>
              <a
                href={`/tags/${tag}/`}
                class="transition-colors hover:text-primary"
                data-pagefind-filter="tag"
              >
                #{tag}
              </a>
            </span>
          ))
        }
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  {
    showOutline && (
      <Fragment slot="aside">
        <PostOutline headings={headings} />
      </Fragment>
    )
  }

  <PostNav older={olderPost} newer={newerPost} />

  <nav class="mt-6">
    <a
      href="/"
      class="text-sm text-text-mute transition-colors hover:text-primary"
    >
      ← 返回文章列表
    </a>
  </nav>
</BaseLayout>
